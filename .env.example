APP_NAME="CMS Rekam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central database: users, roles/permissions, tenant registry, activity log,
# sessions, jobs, cache. Never holds tenant content.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_central
DB_USERNAME=root
DB_PASSWORD=

# Tenant content databases. The database NAME is never set here - it comes from
# the `tenants` table at runtime (cms_rekam, cms_perikanan). Only override host
# or credentials below if tenant databases live on a different server.
DB_TENANT_HOST=127.0.0.1
DB_TENANT_PORT=3306
DB_TENANT_USERNAME=root
DB_TENANT_PASSWORD=
# Prefix used when provisioning a new tenant database (cms_ + slug).
DB_TENANT_PREFIX=cms_

# External datasources: databases owned by *other* systems, neither central nor
# tenant. Declare each one in config/datasources.php, then give it a block here.
# A datasource whose _DATABASE line is missing or empty is treated as absent in
# this environment: /api/v1/ext/<key>/* answers 503 instead of connecting to a
# default. Use a SELECT-only database user - the app enforces read-only too, but
# the grant is the half that survives a bug in ours.
# Verify with: php artisan cms:datasources --ping
#
# COAST - coastal/blue-carbon survey data behind the public map.
DS_COAST_HOST=127.0.0.1
DS_COAST_PORT=3306
DS_COAST_DATABASE=
DS_COAST_USERNAME=
DS_COAST_PASSWORD=

# IKAN - fisheries trip, vessel, gear and catch data.
DS_IKAN_HOST=127.0.0.1
DS_IKAN_PORT=3306
DS_IKAN_DATABASE=
DS_IKAN_USERNAME=
DS_IKAN_PASSWORD=

# BSC - blue swimming crab landings: trips and the crabs measured on them.
DS_BSC_HOST=127.0.0.1
DS_BSC_PORT=3306
DS_BSC_DATABASE=
DS_BSC_USERNAME=
DS_BSC_PASSWORD=

# HIUPARI - shark and ray landings: trips and the individuals measured on them.
DS_HIUPARI_HOST=127.0.0.1
DS_HIUPARI_PORT=3306
DS_HIUPARI_DATABASE=
DS_HIUPARI_USERNAME=
DS_HIUPARI_PASSWORD=

# STSC - national fisheries statistics: fleet and production per WPPNRI per
# year, already aggregated upstream (1990-2021).
DS_STSC_HOST=127.0.0.1
DS_STSC_PORT=3306
DS_STSC_DATABASE=
DS_STSC_USERNAME=
DS_STSC_PASSWORD=

# JOGO LAUT - coastal monitoring station, Cilacap: soil/air CO2, tide, DO,
# pH, CTD and weather-mast sensors, one reading every ~5 minutes (UTC).
DS_JOGOLAUT_HOST=127.0.0.1
DS_JOGOLAUT_PORT=3306
DS_JOGOLAUT_DATABASE=
DS_JOGOLAUT_USERNAME=
DS_JOGOLAUT_PASSWORD=
# Connect timeout (seconds), snapshot length (seconds), and how long a failed
# read is remembered before upstream is tried again (seconds).
DS_JOGOLAUT_TIMEOUT=5
JOGOLAUT_CACHE_TTL=300
JOGOLAUT_FAILURE_TTL=30

# Shared across every datasource: response cache lifetime (seconds) and the
# per-IP limit on /api/v1/ext/*. Both are lower-traffic settings than the
# tenant public API's - an upstream system is usually the fragile dependency.
DS_CACHE_TTL=300
DS_RATE_LIMIT=120

# First administrator, created by AdminUserSeeder on `php artisan db:seed`.
# Only used when that email does not exist yet; changing it later does
# nothing. Use `php artisan cms:user --force` to change a password.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@rekam.org
ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@rekam.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
