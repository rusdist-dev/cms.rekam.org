APP_NAME="CMS Rekam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central database: users, roles/permissions, tenant registry, activity log,
# sessions, jobs, cache. Never holds tenant content.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_central
DB_USERNAME=root
DB_PASSWORD=

# Tenant content databases. The database NAME is never set here - it comes from
# the `tenants` table at runtime (cms_rekam, cms_perikanan). Only override host
# or credentials below if tenant databases live on a different server.
DB_TENANT_HOST=127.0.0.1
DB_TENANT_PORT=3306
DB_TENANT_USERNAME=root
DB_TENANT_PASSWORD=
# Prefix used when provisioning a new tenant database (cms_ + slug).
DB_TENANT_PREFIX=cms_

# First administrator, created by AdminUserSeeder on `php artisan db:seed`.
# Only used when that email does not exist yet; changing it later does
# nothing. Use `php artisan cms:user --force` to change a password.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@rekam.org
ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@rekam.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
